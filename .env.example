# RoadVision AI - Environment Configuration

# FastAPI Backend URL (FastAPI default is http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Default Inference Parameters
VITE_DEFAULT_CONF=0.25
VITE_DEFAULT_IOU=0.45
VITE_DEFAULT_IMGSZ=640

# Maximum file upload size in Megabytes (default: 15MB)
VITE_MAX_FILE_SIZE_MB=15

# Demo mode toggle (set to true to enable simulated predictions when backend is unavailable)
VITE_DEMO_MODE=false
